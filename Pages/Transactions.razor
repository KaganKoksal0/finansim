@page "/transactions"
@using Finansim.Models
@using Microsoft.AspNetCore.Components.Forms
@using Finansim.Services
@inject Finansim.Services.FinanceService Finance
@inject Finansim.Services.StorageService Storage
@inject LocalizationService L

<PageTitle>@L.T("İşlemler - Finansim", "Transactions - Finansim")</PageTitle>

<div class="transactions-page">

    <header class="transactions-header">
        <div>
<a href="/" class="back-link">
    <svg viewBox="0 0 24 24"
         width="18"
         height="18"
         fill="none"
         stroke="currentColor"
         stroke-width="1.8"
         stroke-linecap="round"
         stroke-linejoin="round">
        <path d="M19 12H5" />
        <path d="M12 19L5 12L12 5" />
    </svg>
    @L.T("Ana Sayfa", "Home")
</a>
              <h1>@L.T("İşlemler", "Transactions")<span>.</span></h1>
            <p>@L.T("Gelirlerini ve harcamalarını yönet.", "Manage your income and expenses.")</p>
        </div>

    </header>

    <section class="transaction-form-card">

        <h2>@(editingId.HasValue ? L.T("İşlemi Düzenle", "Edit Transaction") : L.T("Yeni İşlem Ekle", "Add New Transaction"))</h2>

        <EditForm Model="@form" OnSubmit="@SaveTransaction">

            <div class="form-group">
                <label>@L.T("İşlem Türü", "Transaction Type")</label>

               <InputSelect @bind-Value="form.Type" class="form-input">
    <option value="@TransactionType.Expense">@L.T("Gider", "Expense")</option>
    <option value="@TransactionType.Income">@L.T("Gelir", "Income")</option>
    <option value="@TransactionType.CreditCardPayment">@L.T("Kredi Kartı Ödemesi", "Credit Card Payment")</option>
    <option value="@TransactionType.SavingsContribution">@L.T("Birikime Para Ekle", "Add to Savings")</option>
    <option value="@TransactionType.SavingsWithdrawal">@L.T("Birikimden Para Çek", "Withdraw from Savings")</option>
</InputSelect>
            </div>

            <div class="form-group">
                <label>@L.T("Açıklama", "Description")</label>

                <InputText @bind-Value="form.Description"
                           class="form-input"
                           placeholder='@L.T("Örn. Market alışverişi", "e.g. Grocery shopping")' />
            </div>

            <div class="form-group">
                <label>@L.T("Tutar (TL)", "Amount (TRY)")</label>

                <InputNumber @bind-Value="form.Amount"
                             class="form-input"
                             placeholder='@L.T("0,00", "0.00")' />
            </div>

            @if (form.Type == TransactionType.Expense)
{
    <div class="form-group">
        <label>@L.T("Kategori", "Category")</label>

        <InputSelect @bind-Value="form.Category" class="form-input">
            @foreach (var category in Categories)
            {
                <option value="@category">@CategoryLabel(category)</option>
            }
        </InputSelect>
    </div>
}

            @if (form.Type == TransactionType.Expense)
            {
                <div class="form-group">
                    <label>@L.T("Ödeme Yöntemi", "Payment Method")</label>
                    <InputSelect @bind-Value="form.PaymentMethod" class="form-input">
                        <option value="@PaymentMethod.BankAccount">@L.T("Banka Hesabı", "Bank Account")</option>
                        <option value="@PaymentMethod.CreditCard">@L.T("Kredi Kartı", "Credit Card")</option>
                    </InputSelect>
                </div>
            }

            @if (RequiresBankAccount)
            {
                <div class="form-group">
                    <label>@BankAccountFieldLabel</label>
                    <InputSelect TValue="Guid?" @bind-Value="form.BankAccountId" class="form-input">
                        <option value="">@L.T("Banka hesabı seç", "Select a bank account")</option>
                        @foreach (var account in Finance.BankAccounts)
                        {
                            <option value="@account.Id">@account.AccountName — @(Finance.GetBankBalance(account.Id).ToString("N2")) ₺</option>
                        }
                    </InputSelect>
                </div>
            }

            @if (RequiresCreditCard)
            {
                <div class="form-group">
                    <label>@CreditCardFieldLabel</label>
                    <InputSelect TValue="Guid?" @bind-Value="form.CreditCardId" class="form-input">
                        <option value="">@L.T("Kredi kartı seç", "Select a credit card")</option>
                        @foreach (var card in Finance.CreditCards)
                        {
                            <option value="@card.Id">@card.CardName — @L.T("Kullanılabilir: ", "Available: ")@(Finance.GetAvailableLimit(card.Id).ToString("N2")) ₺</option>
                        }
                    </InputSelect>
                </div>
            }

            <div class="form-group">
                <label>@L.T("İşlem Tarihi", "Transaction Date")</label>

                <InputDate @bind-Value="form.Date"
                           class="form-input" />
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="error-message">@errorMessage</div>
            }

            @if (saved)
            {
                <div class="success-message">
                    ✓ @L.T("İşlem başarıyla kaydedildi.", "Transaction saved successfully.")
                </div>
            }

            <div class="form-buttons">

                <button type="submit" class="save-button">
                    @(editingId.HasValue ? L.T("Değişiklikleri Kaydet", "Save Changes") : L.T("İşlem Ekle", "Add Transaction"))
                </button>

                @if (editingId.HasValue)
                {
                    <button type="button"
                            class="cancel-button"
                            @onclick="CancelEdit">
                        @L.T("Vazgeç", "Cancel")
                    </button>
                }

            </div>

        </EditForm>

    </section>

    <section class="transaction-list-card">

        <div class="section-title">
            <div>
                <h2>@L.T("İşlem Geçmişim", "Transaction History")</h2>
                <p>@L.T("Kaydettiğin tüm finansal hareketler", "All your recorded financial activity")</p>
           
            </div>
        </div>
<div class="transaction-filters">

    <div class="filter-search">
        <label for="transaction-search">@L.T("İşlem Ara", "Search Transactions")</label>
        <input id="transaction-search"
               type="text"
               class="form-input"
               @bind="searchText"
               @bind:event="oninput"
               placeholder='@L.T("Açıklama veya kategori ara...", "Search description or category...")' />
    </div>

    <div class="filter-type">
        <label for="transaction-type">@L.T("İşlem Türü", "Transaction Type")</label>
        <select id="transaction-type"
                class="form-input"
                @bind="selectedFilter">
            <option value="Tümü">@L.T("Tüm İşlemler", "All Transactions")</option>
            <option value="Gelir">@L.T("Gelirler", "Income")</option>
            <option value="Gider">@L.T("Giderler", "Expenses")</option>
            <option value="KrediKartıÖdemesi">@L.T("Kredi Kartı Ödemeleri", "Credit Card Payments")</option>
            <option value="Birikim">@L.T("Birikim İşlemleri", "Savings Transactions")</option>
        </select>
    </div>

    <div class="filter-date">
        <label for="filter-start-date">@L.T("Başlangıç Tarihi", "Start Date")</label>
        <InputDate id="filter-start-date"
                   @bind-Value="filterStartDate"
                   class="form-input" />
    </div>

    <div class="filter-date">
        <label for="filter-end-date">@L.T("Bitiş Tarihi", "End Date")</label>
        <InputDate id="filter-end-date"
                   @bind-Value="filterEndDate"
                   class="form-input" />
    </div>

    <button type="button"
            class="clear-filters-button"
            @onclick="ClearFilters">
        @L.T("Filtreleri Temizle", "Clear Filters")
    </button>

</div>
@if (!FilteredTransactions.Any())
        {
    <p class="empty-message">
    @(Finance.Transactions.Any()
        ? L.T("Aramana veya filtrelerine uygun işlem bulunamadı.", "No transactions match your search or filters.")
        : L.T("Henüz işlem eklemedin.", "You have not added any transactions yet."))
</p>        }
        else
        {
@foreach (var item in FilteredTransactions)
            {
                <div class="transaction-row">

                    <div class="transaction-details">
                        <strong>@item.Description</strong>

                       <span>
    @if (item.Type == TransactionType.Expense)
    {
        @CategoryLabel(item.Category)
        <text> · </text>
    }
    @item.Date.ToString("dd/MM/yyyy")
</span>

                      <small>
    @(item.Type switch
    {
        TransactionType.Income => L.T("Gelir", "Income"),
        TransactionType.Expense => item.PaymentMethod == PaymentMethod.CreditCard
            ? L.T("Kredi Kartı", "Credit Card")
            : L.T("Banka Hesabı", "Bank Account"),
        TransactionType.CreditCardPayment => L.T("Kredi Kartı Ödemesi", "Credit Card Payment"),
        TransactionType.SavingsContribution => L.T("Birikime Para Ekle", "Add to Savings"),
        TransactionType.SavingsWithdrawal => L.T("Birikimden Para Çek", "Withdraw from Savings"),
        _ => L.T("Diğer", "Other")
    })
</small>
                        <small class="transaction-account-label">@TransactionAccountLabel(item)</small>
                    </div>

                   <strong class="@((item.Type == TransactionType.Income || item.Type == TransactionType.SavingsWithdrawal) ? "positive" : "negative")">
    @((item.Type == TransactionType.Income || item.Type == TransactionType.SavingsWithdrawal) ? "+" : "-")@item.Amount.ToString("N2") ₺
</strong>

                    <div class="row-buttons">

                        <button type="button"
                                class="edit-button"
                                @onclick="() => EditTransaction(item)">
                            @L.T("Düzenle", "Edit")
                        </button>

                        <button type="button"
                                class="delete-button"
                                @onclick="() => DeleteTransaction(item.Id)">
                            @L.T("Sil", "Delete")
                        </button>

                    </div>

                </div>
            }
        }

    </section>

</div>

@code {
    private string searchText = "";
    private string selectedFilter = "Tümü";
    private DateTime? filterStartDate;
    private DateTime? filterEndDate;

    private Guid? editingId;
    private bool saved;
    private string errorMessage = "";

    private readonly List<string> Categories = new()
    {
        "Yemek", "Market", "Ulaşım", "Eğlence", "Faturalar", "Diğer"
    };

    private Transaction form = new()
    {
        Type = TransactionType.Expense,
        PaymentMethod = PaymentMethod.BankAccount,
        Category = "Yemek",
        Date = DateTime.Today
    };

    private bool RequiresBankAccount =>
        form.Type != TransactionType.Expense || form.PaymentMethod == PaymentMethod.BankAccount;

    private bool RequiresCreditCard =>
        form.Type == TransactionType.CreditCardPayment ||
        (form.Type == TransactionType.Expense && form.PaymentMethod == PaymentMethod.CreditCard);

    private string BankAccountFieldLabel => form.Type == TransactionType.Income
        ? L.T("Hangi hesaba para geldi?", "Which account received the money?")
        : form.Type == TransactionType.CreditCardPayment
            ? L.T("Ödeme hangi banka hesabından yapılacak?", "Which bank account will fund the payment?")
            : form.Type == TransactionType.SavingsWithdrawal
                ? L.T("Para hangi hesaba aktarılacak?", "Which account will receive the money?")
                : L.T("Hangi banka hesabından harcandı?", "Which bank account was used for the expense?");

    private string CreditCardFieldLabel => form.Type == TransactionType.CreditCardPayment
        ? L.T("Hangi kredi kartının borcu ödeniyor?", "Which credit card is being paid?")
        : L.T("Hangi kredi kartı kullanıldı?", "Which credit card was used?");

    private IEnumerable<Transaction> FilteredTransactions
    {
        get
        {
            IEnumerable<Transaction> query = Finance.Transactions;

            query = selectedFilter switch
            {
                "Gelir" => query.Where(x => x.Type == TransactionType.Income),
                "Gider" => query.Where(x => x.Type == TransactionType.Expense),
                "KrediKartıÖdemesi" => query.Where(x => x.Type == TransactionType.CreditCardPayment),
                "Birikim" => query.Where(x =>
                    x.Type == TransactionType.SavingsContribution ||
                    x.Type == TransactionType.SavingsWithdrawal),
                _ => query
            };

            if (filterStartDate.HasValue)
                query = query.Where(x => x.Date.Date >= filterStartDate.Value.Date);

            if (filterEndDate.HasValue)
                query = query.Where(x => x.Date.Date <= filterEndDate.Value.Date);

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                string search = searchText.Trim();
                query = query.Where(x =>
                    x.Description.Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
                    x.Category.Contains(search, StringComparison.CurrentCultureIgnoreCase));
            }

            return query.OrderByDescending(x => x.Date);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await L.InitializeAsync();
        var settings = await Storage.LoadAsync<FinanceSettings>("finance-settings")
            ?? new FinanceSettings();

        FinanceService.NormalizeSettings(settings);
        Finance.Configure(settings);
        await Finance.InitializeAsync();

        ResetForm();
    }

    private void ClearFilters()
    {
        searchText = "";
        selectedFilter = "Tümü";
        filterStartDate = null;
        filterEndDate = null;
    }

    private async Task SaveTransaction(EditContext editContext)
    {
        saved = false;
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(form.Description))
        {
            errorMessage = L.T("İşlem açıklaması girmelisin.", "Please enter a transaction description.");
            return;
        }

        if (form.Amount <= 0)
        {
            errorMessage = L.T("İşlem tutarı sıfırdan büyük olmalıdır.", "The transaction amount must be greater than zero.");
            return;
        }

        Guid? selectedBankId = RequiresBankAccount ? form.BankAccountId : null;
        Guid? selectedCardId = RequiresCreditCard ? form.CreditCardId : null;

        if (RequiresBankAccount &&
            (!selectedBankId.HasValue || !Finance.BankAccounts.Any(x => x.Id == selectedBankId.Value)))
        {
            errorMessage = L.T("İşlem için bir banka hesabı seçmelisin.", "Please select a bank account for this transaction.");
            return;
        }

        if (RequiresCreditCard &&
            (!selectedCardId.HasValue || !Finance.CreditCards.Any(x => x.Id == selectedCardId.Value)))
        {
            errorMessage = L.T("İşlem için bir kredi kartı seçmelisin.", "Please select a credit card for this transaction.");
            return;
        }

        decimal availableBank = selectedBankId.HasValue
            ? Finance.GetBankBalance(selectedBankId.Value)
            : 0;

        decimal availableCardDebt = selectedCardId.HasValue
            ? Finance.GetCreditCardDebt(selectedCardId.Value)
            : 0;

        decimal availableCardLimit = selectedCardId.HasValue
            ? Finance.GetAvailableLimit(selectedCardId.Value)
            : 0;

        decimal availableSavings = Finance.GetSavings();

        // Düzenlenen eski işlemin etkisini, yalnızca aynı hesap/kart seçildiyse geri al.
        var oldTransaction = editingId.HasValue
            ? Finance.Transactions.FirstOrDefault(x => x.Id == editingId.Value)
            : null;

        if (oldTransaction != null)
        {
            if (selectedBankId.HasValue && oldTransaction.BankAccountId == selectedBankId)
                availableBank -= GetBankBalanceEffect(oldTransaction);

            if (selectedCardId.HasValue && oldTransaction.CreditCardId == selectedCardId)
                availableCardDebt -= GetCreditCardDebtEffect(oldTransaction);

            if (oldTransaction.Type == TransactionType.SavingsContribution)
                availableSavings -= oldTransaction.Amount;
            else if (oldTransaction.Type == TransactionType.SavingsWithdrawal)
                availableSavings += oldTransaction.Amount;
        }

        if (form.Type == TransactionType.Expense)
        {
            if (form.PaymentMethod == PaymentMethod.BankAccount && form.Amount > availableBank)
            {
                errorMessage = L.T("Seçtiğin banka hesabının bakiyesi bu harcama için yetersiz.", "The selected bank account does not have enough balance for this expense.");
                return;
            }

            if (form.PaymentMethod == PaymentMethod.CreditCard && form.Amount > availableCardLimit)
            {
                errorMessage = L.T($"Seçtiğin kartın kullanılabilir limiti yetersiz. Kullanılabilir limit: {availableCardLimit:N2} TL", $"The selected card does not have enough available credit. Available credit: {availableCardLimit:N2} TRY");
                return;
            }
        }

        if (form.Type == TransactionType.CreditCardPayment)
        {
            if (availableCardDebt <= 0)
            {
                errorMessage = L.T("Seçtiğin kredi kartında ödenecek borç bulunmuyor.", "There is no outstanding balance on the selected credit card.");
                return;
            }

            if (form.Amount > availableCardDebt)
            {
                errorMessage = L.T($"Ödeme tutarı kart borcundan fazla olamaz. Mevcut borç: {availableCardDebt:N2} TL", $"The payment cannot exceed the card balance. Current balance: {availableCardDebt:N2} TRY");
                return;
            }

            if (form.Amount > availableBank)
            {
                errorMessage = L.T("Seçtiğin banka hesabının bakiyesi kredi kartı ödemesi için yetersiz.", "The selected bank account does not have enough balance for this credit card payment.");
                return;
            }
        }

        if (form.Type == TransactionType.SavingsContribution && form.Amount > availableBank)
        {
            errorMessage = L.T("Seçtiğin banka hesabındaki bakiye birikim aktarımı için yetersiz.", "The selected bank account does not have enough balance for this savings transfer.");
            return;
        }

        if (form.Type == TransactionType.SavingsWithdrawal && form.Amount > availableSavings)
        {
            errorMessage = L.T($"Birikimin yetersiz. Mevcut birikim: {availableSavings:N2} TL", $"Your savings are insufficient. Current savings: {availableSavings:N2} TRY");
            return;
        }

        form.BankAccountId = selectedBankId;
        form.CreditCardId = selectedCardId;

        if (form.Type != TransactionType.Expense)
            form.PaymentMethod = PaymentMethod.BankAccount;

        form.Description = form.Description.Trim();

        try
        {
            if (editingId.HasValue)
            {
                form.Id = editingId.Value;
                await Finance.UpdateTransactionAsync(form);
            }
            else
            {
                form.Id = Guid.NewGuid();
                await Finance.AddTransactionAsync(form);
            }

            saved = true;
            editingId = null;
            ResetForm();
        }
        catch (Exception ex)
        {
            errorMessage = LocalizeException(ex.Message);
        }
    }

    private static decimal GetBankBalanceEffect(Transaction transaction)
    {
        return transaction.Type switch
        {
            TransactionType.Income => transaction.Amount,
            TransactionType.Expense when transaction.PaymentMethod == PaymentMethod.BankAccount => -transaction.Amount,
            TransactionType.CreditCardPayment => -transaction.Amount,
            TransactionType.SavingsContribution => -transaction.Amount,
            TransactionType.SavingsWithdrawal => transaction.Amount,
            _ => 0
        };
    }

    private static decimal GetCreditCardDebtEffect(Transaction transaction)
    {
        return transaction.Type switch
        {
            TransactionType.Expense when transaction.PaymentMethod == PaymentMethod.CreditCard => transaction.Amount,
            TransactionType.CreditCardPayment => -transaction.Amount,
            _ => 0
        };
    }

    private string TransactionAccountLabel(Transaction transaction)
    {
        return transaction.Type switch
        {
            TransactionType.Expense when transaction.PaymentMethod == PaymentMethod.CreditCard =>
                Finance.GetCreditCardName(transaction.CreditCardId),
            TransactionType.CreditCardPayment =>
                $"{Finance.GetCreditCardName(transaction.CreditCardId)} · {Finance.GetBankAccountName(transaction.BankAccountId)}",
            _ => Finance.GetBankAccountName(transaction.BankAccountId)
        };
    }

    private void EditTransaction(Transaction item)
    {
        form = new Transaction
        {
            Id = item.Id,
            Description = item.Description,
            Amount = item.Amount,
            Category = item.Category,
            Type = item.Type,
            PaymentMethod = item.PaymentMethod,
            BankAccountId = item.BankAccountId,
            CreditCardId = item.CreditCardId,
            Date = item.Date
        };

        editingId = item.Id;
        saved = false;
        errorMessage = "";
    }

    private async Task DeleteTransaction(Guid id)
    {
        try
        {
            await Finance.DeleteTransactionAsync(id);
            if (editingId == id)
                CancelEdit();
        }
        catch (Exception ex)
        {
            errorMessage = LocalizeException(ex.Message);
        }
    }

    private void CancelEdit()
    {
        editingId = null;
        ResetForm();
        errorMessage = "";
        saved = false;
    }

    private string CategoryLabel(string category) => category switch
    {
        "Yemek" => L.T("Yemek", "Food"),
        "Market" => L.T("Market", "Groceries"),
        "Ulaşım" => L.T("Ulaşım", "Transport"),
        "Eğlence" => L.T("Eğlence", "Entertainment"),
        "Faturalar" => L.T("Faturalar", "Bills"),
        "Diğer" => L.T("Diğer", "Other"),
        _ => category
    };

    private string LocalizeException(string message) => message switch
    {
        "İşlem bulunamadı." => L.T("İşlem bulunamadı.", "Transaction not found."),
        "İşlem tutarı sıfırdan büyük olmalıdır." => L.T("İşlem tutarı sıfırdan büyük olmalıdır.", "The transaction amount must be greater than zero."),
        "İşlem açıklaması boş bırakılamaz." => L.T("İşlem açıklaması boş bırakılamaz.", "The transaction description cannot be empty."),
        _ => L.T("İşlem sırasında bir hata oluştu. Lütfen tekrar deneyin.", "Something went wrong while processing the transaction. Please try again.")
    };

    private void ResetForm()
    {
        form = new Transaction
        {
            Type = TransactionType.Expense,
            PaymentMethod = PaymentMethod.BankAccount,
            Category = "Yemek",
            BankAccountId = Finance.BankAccounts.FirstOrDefault()?.Id,
            CreditCardId = Finance.CreditCards.FirstOrDefault()?.Id,
            Date = DateTime.Today
        };
    }
}
