@page "/not-found"
@layout MainLayout
@using Finansim.Services
@inject LocalizationService L

<PageTitle>@L.T("Sayfa Bulunamadı", "Page Not Found")</PageTitle>

<h3>@L.T("Sayfa Bulunamadı", "Page Not Found")</h3>
<p>@L.T("Aradığın sayfa mevcut değil.", "The page you are looking for does not exist.")</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        await L.InitializeAsync();
    }
}
