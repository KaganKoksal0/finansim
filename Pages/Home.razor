@code {
private FinanceSettings _settings = new();

private decimal MonthlyBalance =>
    Finance.GetMonthlyIncome(DateTime.Today)
    - Finance.GetMonthlyExpenses(DateTime.Today);

private string BarWidth(decimal amount)
{
    decimal income = Finance.GetMonthlyIncome(DateTime.Today);
    decimal expenses = Finance.GetMonthlyExpenses(DateTime.Today);

    decimal maximum = Math.Max(income, expenses);

    if (maximum <= 0)
        return "0%";

    return (amount / maximum * 100)
        .ToString("0.##", CultureInfo.InvariantCulture) + "%";
}

    private bool isLoading = true;
    private string errorMessage = "";

    private CultureInfo DisplayCulture => CultureInfo.GetCultureInfo(L.IsEnglish ? "en-US" : "tr-TR");

    private async Task SelectLanguageAsync(string language)
    {
        await L.SetLanguageAsync(language);
    }

    protected override async Task OnInitializedAsync()
    {
        await L.InitializeAsync();
        try
        {
            var savedSettings =
                await Storage.LoadAsync<FinanceSettings>("finance-settings");

            if (savedSettings != null)
            {
                _settings = savedSettings;
            }

            FinanceService.NormalizeSettings(_settings);
            Finance.Configure(_settings);
            await Finance.InitializeAsync();
        }
        catch
        {
            errorMessage = L.T("Finansal bilgiler yüklenemedi. Tekrar deneyin.", "Could not load financial information. Please try again.");
        }
        finally
        {
            isLoading = false;
        }
    }
private decimal DailySpendableAmount
{
    get
    {
        if (NextPaymentDate is not DateTime paymentDate)
            return 0;

        int remainingDays = Math.Max(
            1,
            (paymentDate.Date - DateTime.Today).Days + 1
        );

        decimal availableMoney =
            Finance.GetBankBalance()
            - Finance.GetMinimumBankBalance()
            - Finance.GetCreditCardDebt();

        return Math.Max(0, availableMoney / remainingDays);
    }
}

    private DateTime? NextStatementDate
    {
        get
        {
            DateTime today = DateTime.Today;
            var upcomingDates = new List<DateTime>();

            foreach (var card in _settings.CreditCards)
            {
                int statementDay = card.StatementDate?.Day ?? card.StatementDay;
                if (statementDay < 1 || statementDay > 31)
                    continue;

                int dayThisMonth = Math.Min(
                    statementDay,
                    DateTime.DaysInMonth(today.Year, today.Month));

                DateTime candidate = new(today.Year, today.Month, dayThisMonth);

                if (candidate < today)
                {
                    DateTime nextMonth = today.AddMonths(1);
                    int dayNextMonth = Math.Min(
                        statementDay,
                        DateTime.DaysInMonth(nextMonth.Year, nextMonth.Month));
                    candidate = new DateTime(nextMonth.Year, nextMonth.Month, dayNextMonth);
                }

                upcomingDates.Add(candidate);
            }

            return upcomingDates.Count == 0 ? null : upcomingDates.Min();
        }
    }

    private int DaysUntilStatement(DateTime date) =>
        Math.Max(1, (date.Date - DateTime.Today).Days + 1);

    // Bu tutar nakit bütçesidir: minimum hesap bakiyeleri ve mevcut kart borcu ayrılır.
    // Kullanılmamış kart limiti nakit gibi sayılmaz.
    private decimal SpendableUntilStatement => Math.Max(
        0m,
        Finance.GetBankBalance()
        - Finance.GetMinimumBankBalance()
        - Finance.GetCreditCardDebt());

    private decimal DailyStatementSpendingLimit =>
        NextStatementDate is DateTime date
            ? SpendableUntilStatement / DaysUntilStatement(date)
            : 0m;

    private bool HasRecentExpenseHistory => Finance.Transactions.Any(x =>
        x.Type == TransactionType.Expense &&
        x.Date.Date >= DateTime.Today.AddDays(-29) &&
        x.Date.Date <= DateTime.Today);

    private decimal AverageDailyExpensesLast30Days =>
        Finance.Transactions
            .Where(x => x.Type == TransactionType.Expense &&
                        x.Date.Date >= DateTime.Today.AddDays(-29) &&
                        x.Date.Date <= DateTime.Today)
            .Sum(x => x.Amount) / 30m;

    private decimal EstimatedSavingsUntilStatement =>
        NextStatementDate is DateTime date
            ? Math.Max(0m, SpendableUntilStatement -
                (AverageDailyExpensesLast30Days * DaysUntilStatement(date)))
            : 0m;
    private string CreditCardUsageWidth(CreditCard card)
    {
        if (card.TotalLimit <= 0)
            return "0%";

        decimal usage = Math.Clamp(
            Finance.GetCreditCardDebt(card.Id) / card.TotalLimit * 100m,
            0m,
            100m);

        return usage.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    private string Money(decimal amount)
    {
        return amount.ToString("N2", DisplayCulture) + " ₺";
    }

    private decimal SavingsProgress
    {
        get
        {
            decimal target = Finance.GetSavingsTarget();

            if (target <= 0)
                return 0;

            return Math.Clamp(
                Finance.GetSavings() / target * 100,
                0,
                100
            );
        }
    }

    private string ProgressWidth =>
        SavingsProgress.ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private DateTime? NextPaymentDate => Finance.GetNextPaymentDate();

private int DaysUntilPayment(DateTime date)
{
    return (date.Date - DateTime.Today).Days;
}

    private string CategoryLabel(string category) => category switch
    {
        "Yemek" => L.T("Yemek", "Food"),
        "Market" => L.T("Market", "Groceries"),
        "Ulaşım" => L.T("Ulaşım", "Transport"),
        "Eğlence" => L.T("Eğlence", "Entertainment"),
        "Faturalar" => L.T("Faturalar", "Bills"),
        "Diğer" => L.T("Diğer", "Other"),
        _ => category
    };

    private string TransactionTitle(Transaction transaction)
    {
        return transaction.Type switch
        {
            TransactionType.Income => L.T("Para Girişi", "Income"),
            TransactionType.Expense =>
                string.IsNullOrWhiteSpace(transaction.Description)
                    ? CategoryLabel(transaction.Category)
                    : transaction.Description,
            TransactionType.CreditCardPayment => L.T("Kredi Kartı Ödemesi", "Credit Card Payment"),
            TransactionType.SavingsContribution => L.T("Birikim Aktarımı", "Savings Contribution"),
            TransactionType.SavingsWithdrawal => L.T("Birikim Çekimi", "Savings Withdrawal"),
            _ => transaction.Description
        };
    }

    private string TransactionSubtitle(Transaction transaction)
    {
        string date = transaction.Date.ToString(
            "dd MMMM HH:mm",
            DisplayCulture
        );

        string method = transaction.PaymentMethod ==
            PaymentMethod.CreditCard
                ? L.T("Kredi Kartı", "Credit Card")
                : L.T("Banka Hesabı", "Bank Account");

        return $"{date} · {method}";
    }

    private bool IsPositive(Transaction transaction)
    {
        return transaction.Type == TransactionType.Income ||
               transaction.Type == TransactionType.SavingsWithdrawal;
    }

    private string TransactionIcon(Transaction transaction)
    {
        return transaction.Type switch
        {
            TransactionType.Income => "↗",
            TransactionType.Expense => "↘",
            TransactionType.CreditCardPayment => "▣",
            TransactionType.SavingsContribution => "◎",
            TransactionType.SavingsWithdrawal => "↗",
            _ => "₺"
        };
    }
}