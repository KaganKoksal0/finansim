@page "/"
@page "/routecheck"
@using Finansim.Models
@using Finansim.Services
@using System.Globalization
@inject Finansim.Services.StorageService Storage
@inject Finansim.Services.FinanceService Finance
@inject LocalizationService L

<PageTitle>@L.T("Finansim - Ana Sayfa", "Finansim - Home")</PageTitle>

@if (isLoading)
{
    <div class="home-loading">@L.T("Finansal bilgiler yükleniyor...", "Loading financial information...")</div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="home-loading">
        @errorMessage
        <a href="/settings">@L.T("Ayarlara git", "Go to settings")</a>
    </div>
}
else
{
    <div class="dashboard">

        <!-- HEADER -->
        <header class="header">
            <div>
                <h1>Finans<span>ım.</span></h1>
                <p>@L.T("Kişisel Finans Yönetimi", "Personal Finance Management")</p>
            </div>

           <div class="header-date">

    <div class="header-actions">
        <a href="/settings" class="settings-button">
            @L.T("⚙ Ayarlar", "⚙ Settings")
        </a>

        <a href="/transactions" class="settings-button transaction-nav-button">
            <svg class="transaction-nav-icon" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="1.7"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5.5" y="2.5" width="13" height="19" rx="2" />
                <rect x="8.5" y="5.5" width="7" height="3.2" rx="0.6" />
                <path d="M8.5 12h.01M12 12h.01M15.5 12h.01M8.5 16h.01M12 16h.01M15.5 16h.01" stroke-width="2.2" />
            </svg>
            <span>@L.T("İşlemler", "Transactions")</span>
        </a>
    </div>

    <span>@L.T("BUGÜN", "TODAY")</span>
    <strong>@DateTime.Now.ToString("dd MMMM yyyy", DisplayCulture)</strong>

</div>
        </header>

<!-- FINANCIAL SUMMARY -->
<section class="financial-summary">

    <div class="financial-summary-main">

        <div>
            <p class="summary-eyebrow">@L.T("FİNANSAL ÖZETİN", "YOUR FINANCIAL SUMMARY")</p>
            <h2>@L.T("Gelir-Gider Dengesi", "Income and Expense Balance")</h2>
        </div>

        <div class="summary-net">
            <span>@L.T("AYLIK NET DENGE", "MONTHLY NET BALANCE")</span>

            <strong class="@(MonthlyBalance >= 0 ? "positive" : "negative")">
                @(MonthlyBalance > 0 ? "+" : "")@Money(MonthlyBalance)
            </strong>
        </div>

    </div>

    <div class="monthly-balance-breakdown">

    <div class="monthly-balance-heading">
        <h3>@L.T("Aylık Gelir-Gider Dengesi", "Monthly Income and Expenses")</h3>
    </div>

    <div class="monthly-comparison-labels">
        <div class="monthly-comparison-label monthly-comparison-expense">
            <span class="monthly-comparison-dot"></span>
            <div>
                <small>@L.T("Toplam Giden", "Total Outgoing")</small>
                <strong class="negative">@Money(Finance.GetMonthlyExpenses(DateTime.Today))</strong>
            </div>
        </div>

        <div class="monthly-comparison-label monthly-comparison-income">
            <span class="monthly-comparison-dot"></span>
            <div>
                <small>@L.T("Toplam Gelen", "Total Incoming")</small>
                <strong class="positive">@Money(Finance.GetMonthlyIncome(DateTime.Today))</strong>
            </div>
        </div>
    </div>

    <div class="monthly-comparison-track"
         role="img"
         aria-label='@L.T("Aylık gelir ve gider karşılaştırması. Gider solda, gelir sağda.", "Monthly income and expense comparison. Expenses on the left, income on the right.")'>
        <div class="monthly-comparison-half monthly-comparison-left">
            <div class="monthly-comparison-fill expense-fill"
                 style="width: @BarWidth(Finance.GetMonthlyExpenses(DateTime.Today))"></div>
        </div>
        <div class="monthly-comparison-center"></div>
        <div class="monthly-comparison-half monthly-comparison-right">
            <div class="monthly-comparison-fill income-fill"
                 style="width: @BarWidth(Finance.GetMonthlyIncome(DateTime.Today))"></div>
        </div>
    </div>

    <div class="monthly-comparison-direction">
        <span>← @L.T("Gider", "Expenses")</span>
        <span>@L.T("Gelir", "Income") →</span>
    </div>

</div>

<section class="summary-spending-plan">
    <div class="summary-plan-heading">
        <h3>@L.T("Bir Sonraki Hesap Kesimine Kadar", "Until the Next Statement Date")</h3>
        <span>@L.T("Güvenli harcama ve birikim tahmini", "Safe spending and savings estimate")</span>
    </div>

    <div class="summary-plan-grid">
        <div class="summary-plan-card summary-plan-date">
            <span>@L.T("Hesap kesimine kalan", "Time until statement")</span>
            @if (NextStatementDate is DateTime statementDate)
            {
                <strong>@DaysUntilStatement(statementDate) @L.T("gün", DaysUntilStatement(statementDate) == 1 ? "day" : "days")</strong>
                <small>@statementDate.ToString("dd MMMM yyyy", DisplayCulture)</small>
            }
            else
            {
                <strong>—</strong>
                <small>@L.T("Kart ayarlarından hesap kesim tarihi ekle", "Add a statement date in card settings")</small>
            }
        </div>

        <div class="summary-plan-card summary-plan-total">
            <span>@L.T("Güvenli harcama bütçen", "Your safe spending budget")</span>
            <strong>@Money(SpendableUntilStatement)</strong>
            <small>@L.T("Banka bakiyesi − minimum bakiyeler − mevcut kart borcu", "Bank balance − minimum balances − current card debt")</small>
        </div>

        <div class="summary-plan-card summary-plan-daily">
            <span>@L.T("Günlük harcama limitin", "Your daily spending limit")</span>
            @if (NextStatementDate.HasValue)
            {
                <strong>@Money(DailyStatementSpendingLimit)</strong>
                <small>@L.T("Hesap kesimine kadar eşit günlük bütçe", "Equal daily budget until the statement date")</small>
            }
            else
            {
                <strong>—</strong>
                <small>@L.T("Hesap kesim tarihi girildiğinde hesaplanır", "Calculated when a statement date is entered")</small>
            }
        </div>

        <div class="summary-plan-card summary-plan-savings">
            <span>@L.T("Birikime kalabilecek tutar", "Potential savings")</span>
            @if (NextStatementDate.HasValue && HasRecentExpenseHistory)
            {
                <strong>@Money(EstimatedSavingsUntilStatement)</strong>
                <small>@L.T("Son 30 günün günlük gider ortalamasına göre", "Based on average daily expenses over the last 30 days")</small>
            }
